@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model Empleado

@{
    ViewData["Title"] = Localizer["Look up employee"];
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <h1>@Localizer["Look up employee"]</h1>

    <div class="form-floating">

        <form id="formConsultarEmpleado" method="post" asp-controller="Empleado" asp-action="">

            @* Sección para el valor de documentode identidad *@
            <div class="mt-3">
                <label>@Localizer["Value of the identity document"]:</label>
                <input type="text" class="form-control" name="ValorDocumentoIdentidad" value="@Html.DisplayFor(modelItem => Model.ValorDocumentoIdentidad)" readonly>
            </div>

            @* Sección para el nombre *@
            <div class="mt-3">
                <label>@Localizer["Name"]:</label>
                <input type="text" class="form-control" name="Nombre" value="@Html.DisplayFor(modelItem => Model.Nombre)" readonly>
            </div>

            @* Sección para el puesto *@
            <div class="mt-3">
                <label>@Localizer["Position"]:</label>
                <input type="text" class="form-control" name="IdPuestoNavigation.Nombre" value="@Localizer[Model.IdPuestoNavigation.Nombre]" readonly>
            </div>

            @* Sección para el saldo vacaciones *@
            <div class="mt-3">
                <label>@Localizer["Vacation balance"]:</label>
                <input type="text" class="form-control" name="SaldoVacaciones" value="@Html.DisplayFor(modelItem => Model.SaldoVacaciones)" readonly>
            </div>

        </form>

        <div class="mt-3" id="div-botones-consultarEmpleado">
            <button id="btnBackAgregar" class="btn btn-primary" onclick="location.href='@Url.Action("Listar", "Empleado")'">@Localizer["Go back"]</button>
        </div>

    </div>
</body>
</html>