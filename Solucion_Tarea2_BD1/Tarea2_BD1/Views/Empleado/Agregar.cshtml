@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model Empleado

@{
    ViewData["Title"] = Localizer["Add employees"];
}

@* It uses the TempData *@
<partial name="_Notification" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <h1>@Localizer["Add employee"]</h1>

    <div class="form-floating">
        <form id="formAgregarEmp" method="post" asp-controller="Empleado" asp-action="ControlDeErroresAvisos">
            @* Sección para ingresar el valor de documento de identidad *@
            <div class="mt-3">
                <label asp-for="ValorDocumentoIdentidad">@Localizer["Value of the identity document"]:</label>
                <input asp-for="ValorDocumentoIdentidad" type="text" id="entValorDocIdent" class="form-control" placeholder="@Localizer["Write the value of the identity document here"]">
                <span asp-validation-for="ValorDocumentoIdentidad" id="spanValorDocIdent" class="text-danger"></span>
            </div>

            @* Sección para ingresar el nombre *@
            <div class="mt-3">
                <label asp-for="Nombre">@Localizer["Name"]:</label>
                <input asp-for="Nombre" type="text" id="entNombre" class="form-control" placeholder="@Localizer["Write the name here"]">
                <span asp-validation-for="Nombre" id="spanSalario" class="text-danger"></span>
            </div>

            @* Sección para ingresar el puesto *@
            <div id="div-PartialView" class="mt-3">
                <label>@Localizer["Position"]:</label>
                <select id="selectListaPuestos" class="form-select" name="stringPuesto">
                    <option value="nada" selected disabled>@Localizer["Select a position"]:</option>
                    <option value="Albañil">@Localizer["Construction worker"]</option>
                    <option value="Asistente">@Localizer["Assistant"]</option>
                    <option value="Cajero">@Localizer["Cashier"]</option>
                    <option value="Camarero">@Localizer["Waiter"]</option>
                    <option value="Conductor">@Localizer["Driver"]</option>
                    <option value="Conserje">@Localizer["Janitor"]</option>
                    <option value="Cuidador">@Localizer["Caregiver"]</option>
                    <option value="Fontanero">@Localizer["Plumber"]</option>
                    <option value="Niñera">@Localizer["Babysitter"]</option>
                    <option value="Recepcionista">@Localizer["Receptionist"]</option>
                </select>
            </div>
             
        </form>

        <div class="mt-3" id="div-botones-agregarEmpleado">
            <button type="submit" id="btnAgregarEmpleado" class="btn btn-primary" form="formAgregarEmp">@Localizer["Add employee"]</button>
            <button id="btnBackAgregar" class="btn btn-primary" onclick="location.href='@Url.Action("Listar", "Empleado")'">@Localizer["Go back"]</button>
        </div>

    </div>
</body>
</html>