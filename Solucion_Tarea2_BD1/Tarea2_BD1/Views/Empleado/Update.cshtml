@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model ActualizarEmpleado

@{
    ViewData["Title"] = Localizer["Update employee"];
}

@* It uses the TempData *@
<partial name="_Notification" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <h1>@Localizer["Update employee"]</h1>

    <div class="form-floating">

        <form id="formActualizarEmpleado" method="post" asp-controller="Empleado" asp-action="ControlErroresActualizar">

            @* Sección para el valor de documentode identidad original *@
            <div class="mt-3">
                <label>@Localizer["Value of the original identity document"]:</label>
                <input type="text" class="form-control" name="empleadoOriginal.ValorDocumentoIdentidad" value="@Html.DisplayFor(modelItem => Model.empleadoOriginal.ValorDocumentoIdentidad)" readonly>
            </div>

            @* Sección para el nombre original *@
            <div class="mt-3">
                <label>@Localizer["Original name"]:</label>
                <input type="text" class="form-control" name="empleadoOriginal.Nombre" value="@Html.DisplayFor(modelItem => Model.empleadoOriginal.Nombre)" readonly>
            </div>

            @* Sección para el puesto original *@
            <div class="mt-3">
                <label>@Localizer["Original position"]:</label>
                <input type="text" class="form-control" name="empleadoOriginal.IdPuestoNavigation.Nombre"
                value="@Localizer[Model.empleadoOriginal.IdPuestoNavigation.Nombre]" readonly>
            </div>

            @* Sección para el valor de documentode identidad nuevo *@
            <div class="mt-4">
                <label asp-for="empleadoNuevo.ValorDocumentoIdentidad">@Localizer["Value of the new identity document"]:</label>
                <input asp-for="empleadoNuevo.ValorDocumentoIdentidad" type="text" class="form-control" value="" placeholder="@Localizer["Enter the new identity document value here"]">
                <span asp-validation-for="empleadoNuevo.ValorDocumentoIdentidad" class="text-danger"></span>
            </div>

            @* Sección para el nombre nuevo *@
            <div class="mt-3">
                <label asp-for="empleadoNuevo.Nombre">@Localizer["New name"]:</label>
                <input asp-for="empleadoNuevo.Nombre" type="text" class="form-control" placeholder="@Localizer["Enter the new name here"]">
                <span asp-validation-for="empleadoNuevo.Nombre" class="text-danger"></span>
            </div>

            @* Sección para ingresar el puesto nuevo *@
            <div id="div-select" class="mt-3">
                <label>@Localizer["New position"]:</label>
                <select id="selectListaPuestos" class="form-select" name="empleadoNuevo.IdPuestoNavigation.Nombre">
                    <option value="nada" selected disabled>@Localizer["Select a new position"]:</option>
                    <option value="Albañil">@Localizer["Albañil"]</option>
                    <option value="Asistente">@Localizer["Asistente"]</option>
                    <option value="Cajero">@Localizer["Cajero"]</option>
                    <option value="Camarero">@Localizer["Camarero"]</option>
                    <option value="Conductor">@Localizer["Conductor"]</option>
                    <option value="Conserje">@Localizer["Conserje"]</option>
                    <option value="Cuidador">@Localizer["Cuidador"]</option>
                    <option value="Fontanero">@Localizer["Fontanero"]</option>
                    <option value="Niñera">@Localizer["Niñera"]</option>
                    <option value="Recepcionista">@Localizer["Recepcionista"]</option>
                </select>
            </div>

        </form>

        <div class="mt-3" id="div-botones-agregarMovimiento">
            <button type="submit" id="btnAgregar" class="btn btn-primary" form="formActualizarEmpleado">@Localizer["Update"]</button>
            <button id="btnBackAgregar" class="btn btn-primary" onclick="location.href='@Url.Action("Listar", "Empleado")'">@Localizer["Go back"]</button>
        </div>

    </div>
</body>
</html>
