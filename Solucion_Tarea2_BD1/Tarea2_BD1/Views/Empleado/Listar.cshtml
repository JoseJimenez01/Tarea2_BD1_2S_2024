@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<Tarea2_BD1.Models.Empleado>

@{
    ViewData["Title"] = Localizer["Employees"];
}

@* It uses the TempData *@
<partial name="_Notification" />

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <h1>@Localizer["List of Employees"]</h1>

    <div class="form-floating">
        <form id="formFiltrar" method="post" asp-controller="Empleado" asp-action="Filtrar" class="mt-3">
            <div id="div-filtrar">
                <input type="text" name="entradaStringFiltro" id="entFiltro" class="form-control" placeholder="@Localizer["Search by name or identity document value"]">
                <button type="submit" id="btnFiltro" class="btn btn-primary">@Localizer["Search"]</button>
            </div>
        </form>

        <div id="div-lista" class="mt-5">
            @await Html.PartialAsync("_VistaParcialFiltro", Model)
        </div>

        <form action="@Url.Action("Agregar", "Empleado")">
            <input type="submit" id="btnAgregar" class="btn btn-primary" value="@Localizer["Add"]">
        </form>
    </div>
</body>

</html>

