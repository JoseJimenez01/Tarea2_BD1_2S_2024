@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model Usuario

@{
    ViewData["Title"] = @Localizer["User"];
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@* It uses the TempData *@
<partial name="_Notification"/>

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <div class="row">
        <h1>
            @Localizer["Login"]
        </h1>
        <div class="form-floating">
            @* Formulario para la ingresión de datos *@
            <form id="formInicioSesion" method="post" asp-controller="Login" asp-action="ValidarDataAnnotations">
                @* Sección para ingresar el usuario *@
                <div class="mt-5">
                    <label asp-for="Username">@Localizer["User"]:</label>
                    <input type="text" asp-for="Username" id="entUsuario" class="form-control" placeholder="@Localizer["Enter the username here"]">
                    <span asp-validation-for="Username" id="spanUsuario" class="text-danger"></span>
                </div>

                @* Sección para ingresar la contraseña *@
                <div class="mt-3">
                    <label asp-for="Password">@Localizer["Password"]:</label>
                    <input type="text" asp-for="Password" id="entPass" class="form-control" placeholder="@Localizer["Enter the password here"]">
                    <span asp-validation-for="Password" id="spanPass" class="text-danger"></span>
                </div>

            </form>
            @* Sección para los botones *@
            <div class="mt-3" id="div-botones">
                <button type="submit" id="btnSubmit" class="btn btn-primary" form="formInicioSesion">@Localizer["Login"]</button>
            </div>
        </div>
    </div>
</body>
</html>