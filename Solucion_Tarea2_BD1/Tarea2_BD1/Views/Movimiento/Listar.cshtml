@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model VistaListarMovimientos

@{
    ViewData["Title"] = Localizer["Movements"];
}

<!DOCTYPE html>
<html lang="en">
<head>

</head>
<body>
    <h1>@Localizer["List of movements by user"]</h1>

    <div class="form-floating">
        <h5 class="mt-5">@Localizer["Selected employee information"]:</h5>
        <table id="tablaUsuarioMovimientos" class="table table-hover">
            <tr>
                <th id="encNombreEnListaMov">
                    @Localizer["Name"]
                </th>
                <th id="encValorDocIdentEnListaMov">
                    @Localizer["Value of the identity document"]
                </th>
                <th id="encSaldoVacasEnListaMov">
                    @Localizer["Vacation balance"]
                </th>
            </tr>
            @foreach (var item in Model.empleados)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ValorDocumentoIdentidad)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SaldoVacaciones)
                    </td>
                </tr>
            }
        </table>
        <h5 class="mt-5">@Localizer["The employee's movements follow below"]:</h5>
        
        <table id="tablaMovimientos" class="table table-hover">
            <tr>
                <th id="encFechaMov">
                    @Localizer["Date"]
                </th>
                <th id="encNombreMov">
                    @Localizer["Movement name"]
                </th>
                <th id="encMontoMov">
                    @Localizer["Amount"]
                </th>
                <th id="encNuevoSaldoMov">
                    @Localizer["New Balance"]
                </th>
                <th id="encUsuarioMov">
                    @Localizer["User who registered"]
                </th>
                <th id="encIpMov">
                    @Localizer["Ip"]
                </th>
                <th id="encEstampaMov">
                    @Localizer["Timestamp"]
                </th>
            </tr>
            @foreach (var item in Model.movimientos)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Fecha)
                    </td>
                    <td>
                        @* @Html.DisplayFor(modelItem => item.IdTipoMovimientoNavigation.Nombre) *@
                        @Localizer[item.IdTipoMovimientoNavigation.Nombre.ToString()]
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Monto)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NuevoSaldo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IdPostByUserNavigation.Username)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PostInIp)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PostTime)
                    </td>
                </tr>
            }
        </table>

        <div class="mt-3" id="div-botones-agregarEmpleado">
            <button id="btnBackAgregar" class="btn btn-primary" onclick="location.href='@Url.Action("Listar", "Empleado")'">@Localizer["Go back"]</button>
        </div>

    </div>
</body>

</html>
